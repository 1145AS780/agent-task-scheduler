# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Scheduler runtime state: task history, event stream, logs
.ats/
.autopilot/

# Logs
*.log

# Local scratch area: files kept on disk for reference but not shipped.
# Contents are machine-specific (hardcoded local paths), so they must not
# enter the repo. Everything here is ignored on purpose.
temp/

# 重构版工作区（restdesa）：只有说明文档进 git，代码副本与状态不进。
# 实测：restdesa 下 3 个 *.md 已被 git 跟踪，所以不能整目录忽略。
restdesa/scripts/
restdesa/tests/
restdesa/references/
restdesa/.ats/

# Raw conversation transcripts used for context recovery (2.8 MB, machine-local).
# Kept on disk for reference; they must not bloat the shipped repo.
tests/split/

# Follow-up option list: a machine-local scratch memo of "could do, not done".
# It changes every session and carries no shipped value, so keep it out of the repo.
NEXT-OPTIONS.md

# 信任根与封签基线：万一 root 被指到仓库根目录，这两个文件会落在仓库里。
# 密钥是本机私有物、清单是本机代码快照，都不该进 git（历史上从未跟踪过）。
ats_guard_key.json
ats_guard_manifest.json
ats_guard_plugin_manifest.json

# 插件运行态：插件自己通过 state_dir() 写盘的地方，与本机相关，不进仓库。
plugin_state/

# 看门狗写文件用的临时件（先写 .tmp 再原子替换），崩溃残留不该进仓库。
*.tmp

# Python 测试 / 静态检查缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# 合并与编辑器残留
*.orig
*.rej
*.swp
*.swo
*~

# Backups
*.bak
*.bak-*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db